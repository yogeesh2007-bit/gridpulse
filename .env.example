# Copy to .env in the project root. Everything is optional in development.
# (Comments must be on their own lines: a comment after a blank value would be read as the value.)

# development | production. Production refuses to start with unsafe settings.
APP_ENV=development

# ---- auth: JWT access token + rotating refresh token (httpOnly cookie) ------------------------------------
# REQUIRED in production, 32+ random characters:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Set true when served over HTTPS.
COOKIE_SECURE=false
# Needed to register as an operator. Development default when blank: operator-demo
OPERATOR_INVITE_CODE=
# Blank = on in development, off in production.
#   operator@gridpulse.local / Operator123!    driver@gridpulse.local / Driver123!
SEED_DEMO_USERS=

# ---- devices (ESP32 / simulator) --------------------------------------------------------------------------
# If set, devices must send the header X-Device-Key.
DEVICE_API_KEY=
# true re-enables the old unauthenticated dev endpoints (/stations, /seed, ...). Never in production.
LEGACY_API_ENABLED=false

# ---- OpenRouter: OPTIONAL, explanation text only (never used for decisions) ----------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_S=25

# ---- routing + reverse geocoding --------------------------------------------------------------------------
# osrm (falls back to straight-line estimates automatically) | haversine
ROUTING_MODE=osrm
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim usage policy: identify your app and a contact.
NOMINATIM_USER_AGENT="GridPulse/1.0 (you@example.com)"

# ---- demo geography: seeded stations are placed around this point ----------------------------------------------
CENTER_LAT=13.0067
CENTER_LON=80.0037

# ---- database / background services -----------------------------------------------------------------------
# Blank = backend/gridpulse.db
GRIDPULSE_DB=
# Background scheduler clock + WebSocket broadcaster.
SCHEDULER_ENABLED=true
